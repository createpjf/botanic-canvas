{
  "name": "botanic-canvas-ui",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "server": "node --env-file-if-exists=.env --import ./server/sentry.mjs server/index.mjs",
    "worker": "node --env-file-if-exists=.env --import ./server/sentry.mjs server/worker.mjs",
    "test": "node --test api/*.test.mjs server/*.test.mjs scripts/*.test.mjs && node --experimental-strip-types --test src/domain/*.test.ts src/i18n/*.test.ts src/lib/*.test.ts src/store/*.test.ts src/features/agent/*.test.ts src/features/canvas/*.test.ts src/components/*.test.ts",
    "test:e2e": "playwright test",
    "check:architecture": "node scripts/architectureBoundaries.mjs",
    "check:security": "node scripts/securityGate.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:evals": "node scripts/evalGate.mjs && npm run check:intent-evals",
    "check:intent-evals": "node --test server/botanicAgentTurn.test.mjs && node --experimental-strip-types --test src/domain/agentChatContract.test.ts src/domain/agentInstructionRouting.test.ts src/domain/agentTurnObservation.test.ts",
    "smoke:e2e": "node scripts/smokeEndToEnd.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1097.0",
    "@gsap/react": "^2.1.2",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@sentry/node": "^10.72.0",
    "@sentry/react": "^10.72.0",
    "@supabase/supabase-js": "^2.111.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "@xyflow/react": "^12.8.4",
    "bullmq": "^5.81.2",
    "dexie": "^4.0.11",
    "gsap": "^3.15.0",
    "ioredis": "^5.11.1",
    "jpeg-js": "^0.4.4",
    "postgres": "^3.4.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "thinking-orbs": "^0.3.1",
    "ws": "^8.21.1",
    "yjs": "^13.6.31",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.4"
  }
}
