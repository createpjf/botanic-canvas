# 复制为 .env；绝不提交真实密钥。

# Supabase 项目配置：publishable key 只用于前端；secret key 只能给 API / Worker。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_STORAGE_BUCKET=botanic-media
SUPABASE_BOOTSTRAP_OWNER_EMAIL=owner@example.com
# 生产邀请邮件回跳的 Web 地址；不要填写 localhost。
BOTANIC_WEB_URL=https://botanic-canvas.vercel.app/
SUPABASE_INVITE_REDIRECT_TO=https://your-domain.example/auth/callback

# 正式环境：Supabase Auth 签发用户会话；项目、任务和媒体仍由 Railway 持久化。
DATABASE_URL=postgresql://postgres:password@localhost:5432/botanic
BOTANIC_AUTH_PROVIDER=supabase
# 无停机迁移期设为 hybrid：同时接受旧访问令牌与 Supabase JWT；验收后改回 supabase。
# BOTANIC_AUTH_PROVIDER=hybrid
BOTANIC_STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_BUCKET=botanic-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 图像供应商与 Worker。
# 端到端冒烟（npm run smoke:e2e）至少需要 OPENAI_API_KEY 或 MINIMAX_API_KEY 其一：
# 模型目录按 key 是否存在动态构建，没配的 provider 根本不会出现在目录里。
# gpt-image-2 走 images/edits 因此支持蒙版；MiniMax 不支持。
OPENAI_API_KEY=
OPENAI_IMAGE_MODELS=gpt-image-2
IMAGE_API_BASE_URL=https://api.openai.com

# MiniMax Image 01 与 H3（视频）。API 与 Worker 必须配置同一组值。
MINIMAX_API_KEY=
MINIMAX_API_BASE_URL=https://api.minimax.io
MINIMAX_IMAGE_MODELS=image-01
MINIMAX_VIDEO_MODELS=MiniMax-H3
VIDEO_GENERATION_TIMEOUT_MS=1200000

# 提示词润色：Flock API Platform 的 OpenAI-compatible 地址与模型别名。
FLOCK_API_BASE_URL=https://api.flock.io/v1
FLOCK_API_KEY=
# 默认 Agent 模型；可由 Agent Composer 在下列白名单中切换。
FLOCK_TEXT_MODEL=deepseek-v4-flash-vision-exp
FLOCK_AGENT_MODELS=deepseek-v4-flash-vision-exp,kimi-k3,gemini-3.7-flash,glm-5
# 画布生图：有 FLOCK_API_KEY 时出现 Nano Banana。别名必须与 Flock 目录完全一致。
FLOCK_IMAGE_MODELS=gemini-3.1-pro-preview
# 不能原生看图的 Composer 选型用这条做 caption 降级；能看图的型号跟所选走。
# 别名必须与 Flock /v1/models 目录完全一致。
AGENT_VISION_MODEL=gemini-3.7-flash
# 子 Agent 并行调研（Epic 11）。留空即关闭：一次派发会额外产生 2–3 次模型调用，
# 而这条路径不需要用户逐次确认，因此必须显式指定模型才启用，不从主 Agent 模型继承。
# 子任务只能返回结构化提案：它拿不到任何需要确认或会产生终态的工具，也不能改画布、
# 提交生成或调用 MCP —— 那些仍由根 Agent 发起并经用户审批。
AGENT_SUBAGENT_MODEL=
# 独立 Subagent Worker 并发；服务端限制为 1–8，默认 2，避免并行调研挤占主生成队列。
AGENT_SUBAGENT_CONCURRENCY=2
# Context V2 事故总闸门（默认 true）与两阶段放量。shadow 只做本地纯评估，
# 不写 Context State、不调用 Provider，也不改变 legacy 请求结果。
AGENT_CONTEXT_COMPACTION_V2_ENABLED=true
AGENT_CONTEXT_COMPACTION_V2=false
AGENT_CONTEXT_COMPACTION_V2_SHADOW=false
# 默认仅使用 legacy 8k 策略；需要按实际网关模型窗口显式配置。
AGENT_MODEL_CONTEXT_POLICIES_JSON=
# OpenTelemetry traces 默认关闭；开启后通过标准 OTLP/HTTP 发往 Collector。
# Exporter header 可能含密钥，只能存在服务端环境，健康接口不会回显。
AGENT_TELEMETRY_ENABLED=false
# GenAI Semantic Conventions 仍是 development，必须独立显式开启。
AGENT_GENAI_TELEMETRY_ENABLED=false
OTEL_SERVICE_NAME=botanic-agent
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_ARG=0.1
PROMPT_REFINEMENT_TIMEOUT_MS=30000
AGENT_PLANNER_TIMEOUT_MS=55000
# 是否把提供方回传的原始推理（reasoning_content）下发给面板实时展示。
# 默认 false：面板只展示模型自述的摘要级步骤说明。打开后原始推理仍不会写入任何持久化记录。
AGENT_RAW_REASONING=false
# Agent 只能调用这里逐项允许的 MCP 工具；认证信息仅保存在服务端。
# 示例：[{"server":"brand","tool":"search_guideline","url":"https://mcp.example.com/rpc","authToken":"...","timeoutMs":15000}]
BOTANIC_MCP_TOOLS_JSON=[]
# 默认联网搜索走 Tavily Search REST，不要把带 Key 的 MCP URL 填进 BOTANIC_WEB_SEARCH_URL。
BOTANIC_WEB_SEARCH_API_KEY=
BOTANIC_WEB_SEARCH_URL=https://api.tavily.com/search

REDIS_URL=redis://localhost:6379
# 使用 `openssl rand -hex 32` 生成独立随机值；不要复用数据库或 Provider 密钥。
REALTIME_TICKET_SECRET=
REALTIME_PUBLIC_URL=https://api.example.com
MAX_GENERATION_BATCH=8
GENERATION_WORKER_CONCURRENCY=1
PORT=8787

# 第二阶段安全策略。先由 Owner 在账户安全中启用二步验证，再打开强制开关。
SECURITY_REQUIRE_OWNER_MFA=false
SECURITY_API_REQUESTS_PER_MINUTE=600
SECURITY_MEDIA_UPLOADS_PER_MINUTE=30
SECURITY_AGENT_CHATS_PER_5_MINUTES=40
SECURITY_WEB_RESEARCH_PER_MINUTE=20
SECURITY_REALTIME_TICKETS_PER_MINUTE=60
SECURITY_MEMBER_MUTATIONS_PER_HOUR=20
SECURITY_PROMPT_REFINEMENTS_PER_5_MINUTES=30
SECURITY_GENERATION_OUTPUTS_PER_DAY=100

# 仅本地原型使用；production 禁止文件 / 直连 PostgreSQL Adapter。
BOTANIC_DATA_PATH=server/.data/product.json
VITE_PERSISTENCE_MODE=server

# 仅本地应急调试可改为 access-token，不得将访问码写入 VITE_*。
# BOTANIC_AUTH_PROVIDER=access-token
# BOTANIC_BOOTSTRAP_ACCESS_TOKEN=
